        "if (cards[2].className !== 'card locked') throw new Error('parking encore verrouillé');",
        "if (!/1\\/3<\\/b> débloqués/.test(ids['stats'].innerHTML) && !/2\\/3<\\/b> débloqués/.test(ids['stats'].innerHTML)) throw new Error('stats2');",
