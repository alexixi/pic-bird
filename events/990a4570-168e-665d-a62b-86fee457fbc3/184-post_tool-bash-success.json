        "if (cards[0].href !== 'js/catch-bird/index.html') throw new Error('href');",
        "console.log('final :', ids['stats'].innerHTML, '|', cards.map((c) => c.className).join(', '));",
        "",
        "m.resetProgression();",
        "m.renderHub();",
        "if (ids['gameList'].children[1].className !== 'card locked') throw new Error('reset');",
        "console.log('HUB SMOKE OK');",
        "EOF",
        "node /tmp/hub_test2.js && rm /tmp/hub_test2.js"
