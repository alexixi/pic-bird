        "    '<circle cx=\"10\" cy=\"32\" r=\"4.5\" fill=\"#eef5e8\" stroke=\"#8aa87a\"/>' +",
        "    '<circle cx=\"54\" cy=\"32\" r=\"4.5\" fill=\"#eef5e8\" stroke=\"#8aa87a\"/>' +",
