        "  car:",
        "    '<svg viewBox=\"0 0 64 64\" fill=\"none\" stroke=\"#b8860b\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">' +",
        "    '<path d=\"M24 28v-5c0-2 1-3 3-3h10c2 0 3 1 4 3l2 5\" fill=\"#fde8ef\"/>' +",
