        "cat > /tmp/smoke.js <<'EOF'",
        "const fs = require('fs');",
        "const dir = '/home/matheline/Documents/Semestre9/Agentique/pic-bird/src/js/plan-de-table/';",
        "function makeCtx() {",
        "  return new Proxy({}, {",
        "    get: (t, k) => {",
        "      if (k === 'measureText') return () => ({ width: 20 });",
        "      return () => {};",
        "    },",
        "    set: () => true",
        "  });",
        "}",
        "function elStub() {",
        "  return {",
        "    textContent: '', innerHTML: '', title: '', style: {}, dataset: {},",
        "    classList: { add() {}, remove() {}, toggle() {} },",
        "    addEventListener() {}, appendChild() {}, remove() {},",
        "    querySelectorAll: () => [],",
        "    getContext: () => makeCtx(),",
        "    width: 520, height: 520,",
        "    getBoundingClientRect: () => ({ left: 0, top: 0, width: 520, height: 520 })",
        "  };",
        "}",
        "global.document = {",
        "  getElementById: () => elStub(),",
        "  addEventListener() {},",
        "  querySelectorAll: () => [],",
        "  createElement: () => elStub(),",
        "  body: elStub()",
        "};",
        "global.localStorage = { getItem: () => null, setItem() {} };",
        "",
        "const src = fs.readFileSync(dir + 'levels.js', 'utf8') + '\\n' +",
        "  fs.readFileSync(dir + 'game.js', 'utf8') + '\\n' +",
        "  ';({ loadLevel, renderGraph, selectGuest, computeScore, place, sel: () => selected, graphPos, relationsOf })';",
        "const m = eval(src);",
        "",
        "for (let lvl = 0; lvl < 3; lvl++) {",
        "  m.loadLevel(lvl);",
        "  m.renderGraph();                 // sans sélection",
        "  m.selectGuest(0);                // sélection -> relief des relations",
        "  if (m.sel() !== 0) throw new Error('sélection non appliquée');",
        "  m.renderGraph();",
        "  const rel = m.relationsOf(0);",
        "  if (rel.size === 0) throw new Error('relationsOf vide');",
        "  const pos = m.graphPos();",
        "  if (pos.length !== m.computeScore ? 0 : 0) throw new Error('?');",
        "  if (pos.length < 8) throw new Error('graphPos incomplet');",
        "  m.selectGuest(0);                // re-clic -> désélection",
        "  if (m.sel() !== null) throw new Error('désélection non appliquée');",
        "  m.renderGraph();",
        "}",
        "// placement avec conflit (Alice 0 et Hugo 7 ennemis -3 même table) puis sélection",
        "m.loadLevel(0);",
        "m.place(0, 0, 0);",
        "m.place(7, 0, 1);",
        "m.selectGuest(0);",
        "m.renderGraph();",
        "const sc = m.computeScore();",
        "if (sc.conflicts.length !== 1) throw new Error('conflit non détecté: ' + JSON.stringify(sc.conflicts));",
        "console.log('ambiance avec conflit =', sc.ambiance, '% ; conflits =', sc.conflicts.length);",
        "console.log('SMOKE OK');",
        "EOF",
        "node /tmp/smoke.js"
      ]
    },
