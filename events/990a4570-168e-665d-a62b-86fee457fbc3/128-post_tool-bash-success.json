        "const fs = require('fs');",
        "const dir = '/home/matheline/Documents/Semestre9/Agentique/pic-bird/src/';",
        "",
        "// --- localStorage simulé ---",
        "const store = {};",
        "global.localStorage = {",
        "  getItem: (k) => (k in store ? store[k] : null),",
        "  setItem: (k, v) => { store[k] = String(v); },",
        "  removeItem: (k) => { delete store[k]; }",
        "};",
        "global.window = global;",
        "",
        "// --- DOM simulé ---",
        "const ids = {};",
        "function elStub(id) {",
        "  const e = {",
        "    id, textContent: '', title: '', style: {}, dataset: {}, children: [], className: '', href: '',",
        "    classList: { add() {}, remove() {}, toggle() {} },",
        "    addEventListener() {}, appendChild(c) { this.children.push(c); }, remove() {}",
        "  };",
        "  let html = '';",
        "  Object.defineProperty(e, 'innerHTML', {",
        "    get: () => html,",
        "    set: (v) => { html = v; if (v === '') e.children = []; }",
        "  });",
        "  return e;",
        "}",
        "global.document = {",
        "  getElementById: (id) => (ids[id] = ids[id] || elStub(id)),",
        "  createElement: () => elStub('dyn' + Math.random()),",
        "  addEventListener() {}",
        "};",
        "global.confirm = () => true;",
        "",
        "const load = (p) => fs.readFileSync(dir + p, 'utf8');",
        "const src = load('js/plan-de-table/levels.js') + '\\n' + load('js/parking-panic/levels.js') + '\\n' +",
        "  load('js/progression.js') + '\\n' + load('js/main.js') + '\\n' +",
        "  ';({ parcours, resetProgression, GAMES })';",
        "const m = eval(src);",
        "",
        "function states() { return m.parcours().map((s) => (s.unlocked ? 'U' : 'L') + (s.cleared ? 'C' : '-')); }",
        "",
        "// 1) aucune sauvegarde : seul le 1er jeu débloqué",
        "let st = states();",
        "console.log('vide            :', st.join(' '), '|', m.parcours().map(s => s.detail));",
        "if (st.join() !== 'U-,L-,L-') throw new Error('état initial faux: ' + st);",
        "",
        "// 2) catch-bird réussi -> plan de table débloqué",
        "store['picbird.catchBird'] = JSON.stringify({ best: 120, photos: 7 });",
        "st = states();",
        "console.log('catchBird 120   :', st.join(' '));",
        "if (st.join() !== 'UC,U-,L-') throw new Error('après catchBird: ' + st);",
        "",
        "// 3) plan de table : 2 niveaux réussis -> débloqué mais pas réussi",
        "store['picbird.planDeTable'] = JSON.stringify({ unlocked: 1, done: { 0: 85, 1: 78 } });",
        "st = states();",
        "console.log('pdt 2/3         :', st.join(' '), '|', m.parcours()[1].detail);",
        "if (st.join() !== 'UC,U-,L-') throw new Error('après pdt 2/3: ' + st);",
        "",
        "// 4) plan de table 3/3 -> parking débloqué",
        "store['picbird.planDeTable'] = JSON.stringify({ unlocked: 2, done: { 0: 85, 1: 78, 2: 92 } });",
        "st = states();",
        "console.log('pdt 3/3         :', st.join(' '), '|', m.parcours()[1].detail);",
        "if (st.join() !== 'UC,UC,U-') throw new Error('après pdt 3/3: ' + st);",
        "",
        "// 5) parking cleared -> tout réussi",
        "store['picbird.parkingPanic'] = JSON.stringify({ unlocked: 4, done: { 0: 30, 1: 41, 2: 55, 3: 62, 4: 70 }, cleared: true });",
        "st = states();",
        "console.log('parking cleared :', st.join(' '), '|', m.parcours()[2].detail);",
        "if (st.join() !== 'UC,UC,UC') throw new Error('après parking: ' + st);",
        "",
        "// 6) main.js a rendu 3 cartes, la 1re est un lien vers le jeu",
        "const cards = ids['gameList'].children;",
        "if (cards.length !== 3) throw new Error('cartes: ' + cards.length);",
        "if (cards[0].href !== 'js/catch-bird/index.html') throw new Error('href carte 1: ' + cards[0].href);",
        "if (cards[2].href !== 'js/parking-panic/index.html') throw new Error('href carte 3');",
        "if (!/Verrouillé/.test(cards[2].innerHTML) === false) {} // parking débloqué ici",
        "console.log('cartes rendues  :', cards.map((c) => c.className).join(' | '));",
        "",
        "// 7) reset efface les clés",
        "m.resetProgression();",
        "if (Object.keys(store).length !== 0) throw new Error('reset incomplet');",
        "st = states();",
        "if (st.join() !== 'U-,L-,L-') throw new Error('après reset: ' + st);",
        "",
        "console.log('HUB SMOKE OK');",
        "EOF",
        "node /tmp/hub_test.js && rm /tmp/hub_test.js"
      ]
    },
