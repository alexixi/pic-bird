    "tool_input": {
      "file_path": "/home/matheline/Documents/Semestre9/Agentique/pic-bird/src/js/progression.js",
      "content": [
        "'use strict';",
        "",
        "/* ============================================================",
        "   Pic'Bird — progression du parcours (hub)",
        "   - GAMES : les jeux du parcours, dans l'ordre",
        "   - un jeu est verrouillé tant que le précédent n'est pas réussi",
        "   - l'état de chaque jeu est lu dans sa propre clé localStorage,",
        "     écrite par le jeu lui-même :",
        "       catch-bird    -> picbird.catchBird    { best, photos }",
        "       plan-de-table -> picbird.planDeTable  { unlocked, done: {idx: ambiance} }",
        "       parking-panic -> picbird.parkingPanic { unlocked, done: {idx: chrono}, cleared }",
        "   ============================================================ */",
        "",
        "const CATCH_BIRD_SEUIL = 100;  // record (pts) à battre pour réussir Catch Bird",
        "const PARKING_NEED_DONE = 5;   // niveaux à réussir pour réussir Parking Panic",
        "",
        "const GAMES = [",
        "  {",
        "    id: 'catch-bird',",
        "    title: 'Catch Bird',",
        "    tagline: 'Safari photo dans la vallée',",
        "    desc: 'Photographiez les oiseaux sans les effrayer. Cadrage, mise au point, flou, rareté, pose : chaque photo est notée.',",
        "    path: 'js/catch-bird/index.html',",
        "    icon: 'bird'",
        "  },",
        "  {",
        "    id: 'plan-de-table',",
        "    title: 'Plan de Table',",
        "    tagline: 'Amis, ennemis et tables rondes',",
        "    desc: 'Placez les invités autour des tables selon leurs relations pour maximiser l’ambiance du dîner.',",
        "    path: 'js/plan-de-table/index.html',",
        "    icon: 'table'",
        "  },",
        "  {",
        "    id: 'parking-panic',",
        "    title: 'Parking Panic',",
        "    tagline: 'Se garer au clavier',",
        "    desc: 'Garez-vous dans la place cible entre voitures mal garées et circulation, le plus vite possible.',",
        "    path: 'js/parking-panic/index.html',",
        "    icon: 'car'",
        "  }",
        "];",
        "",
        "const SAVE_KEYS = {",
        "  'catch-bird': 'picbird.catchBird',",
        "  'plan-de-table': 'picbird.planDeTable',",
        "  'parking-panic': 'picbird.parkingPanic'",
        "};",
        "",
        "function readGameSave(id) {",
        "  try {",
        "    const raw = localStorage.getItem(SAVE_KEYS[id]);",
        "    return raw ? JSON.parse(raw) : null;",
        "  } catch (e) { return null; }",
        "}",
        "",
        "// Progression interne d'un jeu -> { cleared: bool, detail: string }",
        "function gameProgress(id) {",
        "  const s = readGameSave(id);",
        "  if (id === 'catch-bird') {",
        "    const best = s && s.best ? s.best : 0;",
        "    const photos = s && s.photos ? s.photos : 0;",
        "    return {",
        "      cleared: best >= CATCH_BIRD_SEUIL,",
        "      detail: best > 0",
        "        ? 'Record ' + best + ' pts · ' + photos + ' photo' + (photos > 1 ? 's' : '') + ' — objectif ' + CATCH_BIRD_SEUIL + ' pts'",
        "        : 'Aucune photo pour le moment — objectif : un record de ' + CATCH_BIRD_SEUIL + ' pts'",
        "    };",
        "  }",
        "  if (id === 'plan-de-table') {",
        "    const done = s && s.done ? s.done : {};",
        "    const n = Object.keys(done).length;",
        "    const total = (typeof PLAN_LEVELS !== 'undefined') ? PLAN_LEVELS.length : 3;",
        "    const bestAmb = n ? Math.max.apply(null, Object.keys(done).map((k) => done[k])) : 0;",
        "    return {",
        "      cleared: n >= total,",
        "      detail: n > 0",
        "        ? 'Niveaux réussis ' + n + '/' + total + ' · meilleure ambiance ' + Math.round(bestAmb) + ' %'",
        "        : 'Aucun niveau réussi sur ' + total",
        "    };",
        "  }",
        "  if (id === 'parking-panic') {",
        "    const done = s && s.done ? s.done : {};",
        "    const n = Object.keys(done).length;",
        "    const total = (typeof PARKING_LEVELS !== 'undefined') ? PARKING_LEVELS.length : 8;",
        "    return {",
        "      cleared: !!(s && s.cleared) || n >= PARKING_NEED_DONE,",
        "      detail: n > 0",
        "        ? 'Niveaux réussis ' + n + '/' + total + ' — objectif ' + PARKING_NEED_DONE",
        "        : 'Aucun niveau réussi sur ' + total + ' — objectif ' + PARKING_NEED_DONE",
        "    };",
        "  }",
        "  return { cleared: false, detail: '' };",
        "}",
        "",
        "// Etats du parcours : [{ game, unlocked, cleared, detail }], dans l'ordre des jeux",
        "function parcours() {",
        "  const out = [];",
        "  let prevCleared = true; // le premier jeu est toujours débloqué",
        "  for (const g of GAMES) {",
        "    const p = gameProgress(g.id);",
        "    out.push({ game: g, unlocked: prevCleared, cleared: p.cleared, detail: p.detail });",
        "    prevCleared = p.cleared;",
        "  }",
        "  return out;",
        "}",
        "",
        "function resetProgression() {",
        "  for (const k of Object.keys(SAVE_KEYS)) {",
        "    try { localStorage.removeItem(SAVE_KEYS[k]); } catch (e) {}",
        "  }",
        "}",
        "",
        "window.Progression = { GAMES, CATCH_BIRD_SEUIL, PARKING_NEED_DONE, parcours, resetProgression, readGameSave };",
        ""
      ]
    },
