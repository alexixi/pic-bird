    "tool_input": {
      "timeout": 120,
      "command": [
        "cat > /tmp/hub_test.js <<'EOF'",
        "const fs = require('fs');",
        "const dir = '/home/matheline/Documents/Semestre9/Agentique/pic-bird/src/';",
        "const store = {};",
        "global.localStorage = {",
        "  getItem: (k) => (k in store ? store[k] : null),",
        "  setItem: (k, v) => { store[k] = String(v); },",
        "  removeItem: (k) => { delete store[k]; }",
        "};",
        "global.window = global;",
        "const ids = {};",
        "function elStub(id) {",
        "  const e = {",
        "    id, textContent: '', title: '', style: {}, dataset: {}, children: [], className: '', href: '',",
        "    classList: { add() {}, remove() {}, toggle() {} },",
        "    addEventListener() {}, appendChild(c) { this.children.push(c); }, remove() {}",
        "  };",
        "  let html = '';",
        "  Object.defineProperty(e, 'innerHTML', {",
        "    get: () => html,",
        "    set: (v) => { html = v; if (v === '') e.children = []; }",
        "  });",
        "  return e;",
        "}",
        "global.document = {",
        "  getElementById: (id) => (ids[id] = ids[id] || elStub(id)),",
        "  createElement: () => elStub('dyn' + Math.random()),",
        "  addEventListener() {}",
        "};",
        "global.confirm = () => true;",
        "const load = (p) => fs.readFileSync(dir + p, 'utf8');",
        "const src = load('js/plan-de-table/levels.js') + '\\n' + load('js/parking-panic/levels.js') + '\\n' +",
        "  load('js/progression.js') + '\\n' + load('js/main.js') + '\\n' +",
        "  ';({ parcours, resetProgression, renderHub })';",
        "const m = eval(src);",
        "const states = () => m.parcours().map((s) => (s.unlocked ? 'U' : 'L') + (s.cleared ? 'C' : '-')).join(' ');",
        "",
        "// états initiaux (store vide au chargement)",
        "if (states() !== 'U- L- L-') throw new Error('init: ' + states());",
        "let cards = ids['gameList'].children;",
        "if (cards.length !== 3) throw new Error('cartes: ' + cards.length);",
        "if (cards[0].href !== 'js/catch-bird/index.html') throw new Error('href1');",
        "if (cards[1].href !== '' || cards[2].href !== '') throw new Error('cartes verrouillées ne doivent pas être des liens');",
        "if (!/Verrouillé/.test(cards[2].innerHTML)) throw new Error('badge verrouillé manquant');",
        "console.log('rendu initial   :', cards.map((c) => c.className).join(' | '));",
        "",
        "// parcours complet -> re-rendu",
        "store['picbird.catchBird'] = JSON.stringify({ best: 120, photos: 7 });",
        "store['picbird.planDeTable'] = JSON.stringify({ unlocked: 2, done: { 0: 85, 1: 78, 2: 92 } });",
        "store['picbird.parkingPanic'] = JSON.stringify({ unlocked: 4, done: { 0: 30, 1: 41, 2: 55, 3: 62, 4: 70 }, cleared: true });",
        "if (states() !== 'UC UC UC') throw new Error('final: ' + states());",
        "m.renderHub();",
        "cards = ids['gameList'].children;",
        "if (cards[0].href !== 'js/catch-bird/index.html' || cards[1].href !== 'js/plan-de-table/index.html' || cards[2].href !== 'js/parking-panic/index.html')",
        "  throw new Error('hrefs: ' + cards.map((c) => c.href));",
        "if (!/Réussi/.test(cards[2].innerHTML)) throw new Error('badge Réussi manquant');",
        "if (!/Record 120 pts/.test(cards[0].innerHTML)) throw new Error('détail catch-bird manquant');",
        "console.log('rendu complet   :', cards.map((c) => c.className).join(' | '));",
        "",
        "// reset",
        "m.resetProgression();",
        "if (Object.keys(store).length !== 0) throw new Error('reset incomplet');",
        "if (states() !== 'U- L- L-') throw new Error('après reset: ' + states());",
        "console.log('HUB SMOKE OK');",
        "EOF",
        "node /tmp/hub_test.js && rm /tmp/hub_test.js"
      ]
    },
