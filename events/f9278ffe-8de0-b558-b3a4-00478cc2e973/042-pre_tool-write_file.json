        "<!DOCTYPE html>",
        "<html lang=\"fr\">",
        "<head>",
        "<meta charset=\"UTF-8\">",
        "<title>test-render</title>",
        "<link rel=\"stylesheet\" href=\"style.css\">",
        "</head>",
        "<body>",
        "<header id=\"hud\">",
        "  <span class=\"brand\">Plan de Table</span>",
        "  <span>Niveau <b id=\"hLevel\">1</b></span>",
        "  <span class=\"jaugeWrap\">Ambiance",
        "    <span class=\"jauge\"><span id=\"hAmbFill\"></span><i id=\"hAmbGoal\"></i></span>",
        "    <b id=\"hAmb\">0</b>",
        "  </span>",
        "  <span>Objectif <b id=\"hGoal\">—</b></span>",
        "  <span>Conflits <b id=\"hConflicts\">0</b></span>",
        "  <button id=\"btnValidate\" type=\"button\">Valider le plan</button>",
        "  <button id=\"btnReset\" type=\"button\">Recommencer</button>",
        "  <button id=\"btnLevels\" type=\"button\">Niveaux</button>",
        "</header>",
        "<main id=\"board\">",
        "  <section id=\"relationsPanel\">",
        "    <h2>Schéma des relations</h2>",
        "    <canvas id=\"graph\" width=\"460\" height=\"460\"></canvas>",
        "    <div id=\"legend\"></div>",
        "    <h3 id=\"warnTitle\">À surveiller</h3>",
        "    <ul id=\"warnings\"></ul>",
        "  </section>",
        "  <section id=\"tablesPanel\">",
        "    <h2 id=\"levelName\">—</h2>",
        "    <p id=\"levelDesc\"></p>",
        "    <div id=\"tables\"></div>",
        "    <div id=\"benchWrap\"><h3>Invités à placer</h3><div id=\"bench\"></div></div>",
        "  </section>",
        "</main>",
        "<div id=\"toast\"></div>",
        "<div id=\"start\" class=\"overlay\"><div class=\"box\"><button id=\"startBtn\" type=\"button\">Jouer</button></div></div>",
        "<div id=\"levelsOverlay\" class=\"overlay hidden\"><div class=\"box\"><div id=\"levelList\"></div><button id=\"levelsClose\" type=\"button\">Fermer</button></div></div>",
        "<div id=\"winOverlay\" class=\"overlay hidden\"><div class=\"box\"><h2 id=\"winTitle\"></h2><p id=\"winText\"></p>",
        "  <div class=\"row\"><button id=\"winNext\" type=\"button\">Niveau suivant</button><button id=\"winRetry\" type=\"button\">Rejouer</button><button id=\"winLevels\" type=\"button\">Niveaux</button></div>",
        "</div></div>",
        "<script src=\"levels.js\"></script>",
        "<script src=\"game.js\"></script>",
        "<script>",
        "window.addEventListener('DOMContentLoaded', () => {",
        "  try {",
        "    document.getElementById('startBtn').click();",
        "    // niveau 3 si demandé via #n3, sinon niveau débloqué",
        "    const m = location.hash.match(/^#n(\\d+)$/);",
        "    if (m) loadLevel(Math.min(+m[1] - 1, PLAN_LEVELS.length - 1));",
        "    // placement automatique : table = g % tables, siège = g % seats (crée des conflits)",
        "    for (let g = 0; g < level.guests.length; g++) place(g, g % level.tables, g % level.seats);",
        "    const sc = computeScore();",
        "    document.title = 'TEST ambiance=' + sc.ambiance + ' conflits=' + sc.conflicts.length +",
        "      ' tokens=' + document.querySelectorAll('.token').length +",
        "      ' seats=' + document.querySelectorAll('.seat').length +",
        "      ' warnings=' + document.querySelectorAll('#warnings li').length;",
        "  } catch (e) {",
        "    document.title = 'TEST ERROR ' + e.message;",
        "  }",
        "});",
        "</script>",
        "</body>",
        "</html>",
        ""
      ]
    }
  }
