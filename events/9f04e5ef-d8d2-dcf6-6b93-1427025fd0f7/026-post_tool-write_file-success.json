        "<body>",
        "",
        "<header id=\"hud\">",
        "  <span class=\"brand\"><svg width=\"34\" height=\"20\" viewBox=\"0 0 34 20\" aria-hidden=\"true\"><rect x=\"1\" y=\"6\" width=\"32\" height=\"10\" rx=\"4\" fill=\"#e8a13a\" stroke=\"#7a5a14\" stroke-width=\"1.5\"/><rect x=\"8\" y=\"2\" width=\"16\" height=\"8\" rx=\"3\" fill=\"#bcd8ea\" stroke=\"#7a5a14\" stroke-width=\"1.5\"/><circle cx=\"8\" cy=\"17\" r=\"3\" fill=\"#2b2b30\"/><circle cx=\"26\" cy=\"17\" r=\"3\" fill=\"#2b2b30\"/></svg>Parking Panic</span>",
