    "tool_input": {
      "file_path": "/home/alexisgb/Documents/enseirb/Semestre9/agentique/pic-bird/src/js/parking-panic/render.js",
      "content": [
        "'use strict';",
        "",
        "/* ============================================================",
        "   Parking Panic — rendu du monde (canvas 2D)",
        "   Caméra qui suit le joueur, routes, places de parking, voitures",
        "   garées, circulation et voiture du joueur (feux selon l'état).",
        "   ============================================================ */",
        "",
        "const VIEW_W = 1150, VIEW_H = 700; // zone du monde visible (unités)",
        "",
        "function rr(c, x, y, w, h, r) {",
        "  r = Math.min(r, w / 2, h / 2);",
        "  c.beginPath();",
        "  c.moveTo(x + r, y);",
        "  c.arcTo(x + w, y, x + w, y + h, r);",
        "  c.arcTo(x + w, y + h, x, y + h, r);",
        "  c.arcTo(x, y + h, x, y, r);",
        "  c.arcTo(x, y, x + w, y, r);",
        "  c.closePath();",
        "}",
        "",
        "// Voiture centrée en (x, y), cap `angle`, carrosserie L×W.",
        "// opts : { color, braking, reverse, angry }",
        "function drawCar(c, x, y, angle, L, W, opts) {",
        "  const o = opts || {};",
        "  c.save();",
        "  c.translate(x, y);",
        "  c.rotate(angle);",
        "  // ombre",
        "  c.fillStyle = 'rgba(0,0,0,0.25)';",
        "  rr(c, -L / 2 + 2, -W / 2 + 3, L, W, W / 2.2); c.fill();",
        "  // carrosserie",
        "  c.fillStyle = o.color || '#cccccc';",
        "  rr(c, -L / 2, -W / 2, L, W, W / 2.4); c.fill();",
        "  c.strokeStyle = 'rgba(0,0,0,0.45)'; c.lineWidth = 1.5; c.stroke();",
        "  // vitres : pare-brise à l'avant (+x), lunette à l'arrière",
        "  c.fillStyle = 'rgba(190,220,235,0.9)';",
        "  rr(c, -L * 0.06, -W / 2 + 2.5, L * 0.2, W - 5, 3); c.fill();",
        "  rr(c, -L * 0.44, -W / 2 + 2.5, L * 0.18, W - 5, 3); c.fill();",
        "  // toit",
        "  c.fillStyle = 'rgba(0,0,0,0.18)';",
        "  rr(c, -L * 0.27, -W / 2 + 3, L * 0.15, W - 6, 3); c.fill();",
        "  // roues",
        "  c.fillStyle = '#17181c';",
        "  const wy = W / 2 - 1.5;",
        "  for (const [wx, sy] of [[-L * 0.32, -1], [L * 0.32, -1], [-L * 0.32, 1], [L * 0.32, 1]]) {",
        "    rr(c, wx - 4.5, sy * wy - 2.6, 9, 5.2, 2); c.fill();",
        "  }",
        "  // phares (avant)",
        "  c.fillStyle = '#f5f0c8';",
        "  c.beginPath(); c.arc(L / 2 - 1.5, -W / 4, 2.2, 0, Math.PI * 2); c.fill();",
        "  c.beginPath(); c.arc(L / 2 - 1.5, W / 4, 2.2, 0, Math.PI * 2); c.fill();",
        "  // feux arrière (rougris, vifs au freinage)",
        "  c.fillStyle = o.braking ? '#ff2a2a' : 'rgba(200,60,50,0.8)';",
        "  c.beginPath(); c.arc(-L / 2 + 1.5, -W / 4, 2.2, 0, Math.PI * 2); c.fill();",
        "  c.beginPath(); c.arc(-L / 2 + 1.5, W / 4, 2.2, 0, Math.PI * 2); c.fill();",
        "  // feu de recul (marche arrière engagée)",
        "  if (o.reverse) {",
        "    c.fillStyle = '#ffffff';",
        "    c.beginPath(); c.arc(-L / 2 + 1.5, 0, 2.6, 0, Math.PI * 2); c.fill();",
        "  }",
        "  c.restore();",
        "  // klaxon énervé au-dessus de la voiture",
        "  if (o.angry > 0) {",
        "    c.fillStyle = '#ffd23a';",
        "    c.font = 'bold 16px sans-serif';",
        "    c.textAlign = 'center';",
        "    c.fillText('!', x, y - W / 2 - 8);",
        "  }",
        "}",
        "",
        "function drawGame(c, CW, CH, S) {",
        "  c.setTransform(1, 0, 0, 1, 0, 0);",
        "  c.fillStyle = '#20222a';",
        "  c.fillRect(0, 0, CW, CH);",
        "  if (!S.level) return;",
        "  const level = S.level;",
        "",
        "  // caméra : suit le joueur, bornée au monde",
        "  const s = Math.min(CW / VIEW_W, CH / VIEW_H);",
        "  const visW = CW / s, visH = CH / s;",
        "  const clampCam = (v, vis, world) => (vis >= world ? world / 2 : Math.max(vis / 2, Math.min(world - vis / 2, v)));",
        "  const camX = clampCam(S.player ? S.player.x : level.world.w / 2, visW, level.world.w);",
        "  const camY = clampCam(S.player ? S.player.y : level.world.h / 2, visH, level.world.h);",
        "  c.setTransform(s, 0, 0, s, CW / 2 - camX * s, CH / 2 - camY * s);",
        "",
        "  const w = level.world;",
        "  // sol du parking",
        "  c.fillStyle = '#4b4e58';",
        "  c.fillRect(0, 0, w.w, w.h);",
        "  c.strokeStyle = '#2c2e36'; c.lineWidth = 6;",
        "  c.strokeRect(0, 0, w.w, w.h);",
        "  // décors (trottoirs, etc.)",
        "  for (const d of level.decor || []) {",
        "    c.fillStyle = d.color || '#666a74';",
        "    c.fillRect(d.x, d.y, d.w, d.h);",
        "    c.strokeStyle = 'rgba(0,0,0,0.3)'; c.lineWidth = 2;",
        "    c.strokeRect(d.x, d.y, d.w, d.h);",
        "  }",
        "  // routes : asphalte foncé, ligne médiane jaune, bandes de rive",
        "  for (const r of level.roads) {",
        "    c.fillStyle = '#3a3d46';",
        "    c.fillRect(r.x, r.y, r.w, r.h);",
        "    c.strokeStyle = 'rgba(255,255,255,0.55)'; c.lineWidth = 2;",
        "    c.strokeRect(r.x + 3, r.y + 3, r.w - 6, r.h - 6);",
        "    c.strokeStyle = '#d9b23a'; c.lineWidth = 2.5; c.setLineDash([18, 16]);",
        "    c.beginPath();",
        "    if (r.w >= r.h) { const y = r.y + r.h / 2; c.moveTo(r.x + 8, y); c.lineTo(r.x + r.w - 8, y); }",
        "    else { const x = r.x + r.w / 2; c.moveTo(x, r.y + 8); c.lineTo(x, r.y + r.h - 8); }",
        "    c.stroke();",
        "    c.setLineDash([]);",
        "  }",
        "  // places de parking (la cible pulse en vert)",
        "  level.spots.forEach((sp, i) => {",
        "    const target = i === level.target;",
        "    c.save();",
        "    c.translate(sp.x, sp.y);",
        "    c.rotate(sp.angle);",
        "    if (target) {",
        "      const pulse = 0.25 + 0.15 * Math.sin(performance.now() / 250);",
        "      c.fillStyle = 'rgba(76,224,122,' + pulse.toFixed(3) + ')';",
        "      c.fillRect(-sp.w / 2, -sp.h / 2, sp.w, sp.h);",
        "      c.strokeStyle = '#4ce07a'; c.lineWidth = 3.5;",
        "    } else {",
        "      c.strokeStyle = 'rgba(255,255,255,0.75)'; c.lineWidth = 2.5;",
        "    }",
        "    c.strokeRect(-sp.w / 2, -sp.h / 2, sp.w, sp.h);",
        "    c.restore();",
        "  });",
        "  // voitures garées (dont mal garées)",
        "  for (const p of level.parked) {",
        "    drawCar(c, p.x, p.y, p.angle, p.w, p.h, { color: p.color });",
        "  }",
        "  // circulation",
        "  for (const t of S.traffic) {",
        "    if (t.active) {",
        "      drawCar(c, t.x, t.y, t.angle, t.spec.L, t.spec.W, { color: t.def.color, braking: t.braking, angry: t.angry });",
        "    }",
        "  }",
        "  // voiture du joueur",
        "  if (S.player) {",
        "    const p = S.player;",
        "    drawCar(c, p.x, p.y, p.angle, p.spec.L, p.spec.W, {",
        "      color: p.spec.color,",
        "      braking: !!(S.inp && S.inp.down),",
        "      reverse: p.gear < 0",
        "    });",
        "  }",
        "  // flash rouge après un choc",
        "  if (S.flash > 0) {",
        "    c.setTransform(1, 0, 0, 1, 0, 0);",
        "    c.fillStyle = 'rgba(214,69,69,' + Math.min(0.35, S.flash).toFixed(3) + ')';",
        "    c.fillRect(0, 0, CW, CH);",
        "  }",
        "}",
        ""
      ]
    }
  }
}
